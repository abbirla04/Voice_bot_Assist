# Copy to .env.local and fill in. Run `python src/agent.py preflight` to check.

# --- REQUIRED: LiveKit Cloud project (cloud.livekit.io -> Settings -> Keys) ---
# Gives you rooms, SIP/telephony, the turn detector, adaptive interruption,
# noise cancellation and LiveKit Inference (Deepgram STT, fallback LLM/TTS).
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Your own provider keys ---
GOOGLE_API_KEY=            # Gemini: primary LLM
ANTHROPIC_API_KEY=         # Claude: backup LLM + eval judge
ELEVEN_API_KEY=            # ElevenLabs: primary voice + backup speech-to-text
ELEVEN_VOICE_ID=           # an Indian female voice for Clara (Voice Library ID)
# How the voice speaks. Defaults are calm and even (a front desk never sounds sharp);
# changing any of them re-records the greetings on the next START-PHONE-TEST.
# ELEVEN_STABILITY=0.75      # higher = steadier, less emotional swing (0-1)
# ELEVEN_SIMILARITY=0.75
# ELEVEN_STYLE=0             # 0 = no acting
# ELEVEN_SPEED=0.95          # 0.8-1.2
# ELEVEN_SPEAKER_BOOST=0
# ELEVEN_VOICE_SETTINGS=voice   # use the voice's own saved ElevenLabs settings instead
# Phone loudness (Exotel calls): turned down and peak-limited so no word jumps out
# BOT_OUTPUT_GAIN_DB=-6
# BOT_OUTPUT_CEILING_DB=-4      # 0 and 0 = untouched
# XAI_API_KEY=             # Grok (optional extra LLM fallback)

# --- Provider chains (primary first; items with missing keys are skipped) ---
# STT_CHAIN=livekit/deepgram/nova-3@multi, elevenlabs/scribe_v2_realtime
# LLM_CHAIN=anthropic/claude-sonnet-5-5, anthropic/claude-haiku-5-5, livekit/openai/gpt-4.1-mini
# How much Claude thinks before answering (low = fastest first word; empty = model default)
# ANTHROPIC_EFFORT=low
# TTS_CHAIN=elevenlabs/eleven_flash_v2_5, livekit/cartesia/sonic-3@hi
# LIVEKIT_TTS_VOICE=       # voice id for the livekit/cartesia fallback voice
# LLM_ATTEMPT_TIMEOUT_S=4.0

# --- Telephony (Exotel <-> LiveKit SIP) ---
# Needed for warm transfers and outbound (Clara) calls.
# LIVEKIT_SIP_OUTBOUND_TRUNK=ST_xxxxxxxx
# LIVEKIT_SIP_NUMBER=+91xxxxxxxxxx   # caller ID shown when we dial out

# Exotel Voicebot applet bridge (src/exotel_bridge.py), for accounts without SIP
# EXOTEL_BRIDGE_PORT=8765            # point ngrok at this port
# EXOTEL_BRIDGE_HOST=127.0.0.1       # 0.0.0.0 to accept from other machines (e.g. Docker)
# EXOTEL_AGENT_JOIN_TIMEOUT_S=15     # no agent by then -> call ends (is agent.py dev running?)
# HANGUP_TAIL_S=0.6                  # let the goodbye reach the phone before hanging up
# EXOTEL_RECORD_DIR=logs/audio       # TEST ONLY: record caller + bot audio per call (off when unset)

# --- Behaviour ---
# TURN_MAX_DELAY_S=1.0        # longest wait for an unsure end of turn (TTFA worst case)
# NOISE_CANCELLATION=off       # default: off for phone (Exotel) calls, ai-coustics otherwise
# INTERRUPTION_MODE=adaptive     # default: adaptive with LiveKit Cloud keys, else vad
# USER_AWAY_TIMEOUT_S=15
# SILENCE_REPROMPT_S=8
# AGENT_NAME=eye-front-desk

# --- Notifications (SMS confirmations, callback requests, emergency alerts) ---
# NOTIFY_WEBHOOK_URL=https://your-n8n-or-backend/hooks/frontdesk
# NOTIFY_WEBHOOK_TOKEN=

# --- Go-live guard ---
# `dev`/`start` refuse the sample clinic.yaml (fake doctors/fees) unless this is set.
# Set it while TESTING; remove it once config/clinic.yaml has real data.
ALLOW_PLACEHOLDER_DATA=1

# --- Benchmarks ---
# JUDGE_LLM=anthropic/claude-sonnet-5-5   # grades the SOP evals (must differ from the bot's model)
# BENCH_CALLER_TTS=livekit/cartesia/sonic-3@hi   # voice for the synthetic caller

# --- Testing knobs (mock scheduler) ---
# MOCK_SCHEDULER_LATENCY_S=0
# MOCK_SCHEDULER_FAIL=0

# --- WhatsApp (Meta WhatsApp Cloud API; src/whatsapp_bot.py) ---
# WHATSAPP_TOKEN=            # system-user access token (WhatsApp > API Setup for a temporary one)
# WHATSAPP_PHONE_NUMBER_ID=  # "Phone number ID" from WhatsApp > API Setup
# WHATSAPP_WABA_ID=          # "WhatsApp Business account ID" (same page); the bot links it to the app
# WHATSAPP_APP_ID=           # App settings > Basic > App ID (only for WHATSAPP-PROFILE.bat, the DP upload)
# WHATSAPP_APP_SECRET=       # App settings > Basic > App secret (checks Meta signed each call)
# WHATSAPP_VERIFY_TOKEN=     # any random text; type the same text in Meta's webhook form
# WHATSAPP_LLM_TIMEOUT_S=15  # how long a chat waits for Claude before the backup model
# WHATSAPP_IDLE_CLOSE_S=120  # patient quiet this long: chat closed (polite message if a question was open), next message starts over (0 = off)

# START-PHONE-TEST.bat
# NGROK_DOMAIN=your-name.ngrok-free.dev
# PHONE_TEST_NUMBERS=011-xxx-xxxxx and 095-xxx-xxxxx
